# dam-backend base URL for server-side calls (chat proxy, quotes, news).
# Same host as dam-admin VITE_API_URL.
CHAT_API_URL=https://104-248-198-154.sslip.io

# Browser Socket.io host only (HTTP chat stays same-origin via the /chat proxy route).
NEXT_PUBLIC_CHAT_API_URL=https://104-248-198-154.sslip.io

# Shared secret with dam-backend (same CHAT_PROXY_KEY there). Lets the backend
# rate-limit each visitor separately instead of the whole site as one visitor.
# Server-only: never prefix with NEXT_PUBLIC_.
CHAT_PROXY_KEY=

# Optional: custom domain of the R2 public bucket (e.g. media.example.com), so admin
# uploads there are resized by the image optimizer. *.r2.dev is always allowed.
NEXT_PUBLIC_MEDIA_HOST=
