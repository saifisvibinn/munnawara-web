# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local design references
.stitch-ref/

# Cursor local config — keep design hook trackable; skills live in .agents/skills
.cursor/*
!.cursor/hooks.json

# Impeccable local runtime (shared hook config is committed)
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/live/
.impeccable/build/

# temp / local scratch
tmp-*.png
tmp-*.tsx
tmp-*.mjs
tmp-*/
tmp-*/

.vercel
